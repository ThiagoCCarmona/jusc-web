// Prisma Schema para JUSC Web (desenvolvimento local com SQLite)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id             String         @id @default(cuid())
  nome           String
  login          String         @unique // Nome de usuário definido pelo admin (ex: admin, brunao, foletto)
  email          String?        // E-mail opcional
  senhaHash      String
  perfil         String         @default("COLABORADOR") // "ADMIN" | "COLABORADOR"
  status         String         @default("ATIVO")       // "ATIVO" | "INATIVO"
  primeiroAcesso Boolean        @default(true)          // Se true, exige troca no primeiro acesso
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  integrantesCadastrados Integrante[]   @relation("CadastradoPor")
  encontrosCriados       Encontro[]     @relation("EncontroCriadoPor")
  bannersCriados         Banner[]       @relation("BannerCriadoPor")
  auditorias             LogAuditoria[]
}

model Integrante {
  id                     String    @id @default(cuid())
  nomeCompleto           String
  apelido                String?
  telefone               String
  dataNascimento         DateTime
  nomeResponsavel        String
  telefoneResponsavel    String
  fotoUrl                String?
  sexo                   String?   @default("MASCULINO") // "MASCULINO" | "FEMININO"

  // Lógica de tempo de grupo com 3 níveis de precisão
  tempoGrupoPrecisao     String    @default("DESCONHECIDA") // "COMPLETA" | "MES_ANO" | "DESCONHECIDA"
  tempoGrupoDataCompleta DateTime?
  tempoGrupoMes          Int?
  tempoGrupoAno          Int?

  // Sacramentos
  batismo                Boolean   @default(false)
  primeiraEucaristia     Boolean   @default(false)
  crisma                 Boolean   @default(false)

  // Curso de Liderança Juvenil (CLJ)
  fezClj                 Boolean   @default(false)
  qualClj                String?

  // Grupo WhatsApp
  noGrupoWhatsapp        Boolean   @default(false)

  // Saúde e Restrições Alimentares (Alergias e Intolerâncias)
  possuiAlergia          Boolean   @default(false)
  descricaoAlergia       String?
  intoleranciaGluten     Boolean   @default(false)
  intoleranciaLactose    Boolean   @default(false)

  observacao             String?
  status                 String    @default("ATIVO") // "ATIVO" | "INATIVO"
  motivoInativacao       String?

  cadastradoPorId        String
  cadastradoPor          Usuario   @relation("CadastradoPor", fields: [cadastradoPorId], references: [id])
  dataCadastro           DateTime  @default(now())
  atualizadoEm           DateTime  @updatedAt

  presencas              Presenca[]
}

model Encontro {
  id           String     @id @default(cuid())
  dataHora     DateTime
  local        String
  conduzidoPor String
  tema         String?
  observacao   String?

  criadoPorId  String
  criadoPor    Usuario    @relation("EncontroCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm     DateTime   @default(now())

  presencas    Presenca[]
}

model Presenca {
  id            String      @id @default(cuid())
  encontroId    String
  encontro      Encontro    @relation(fields: [encontroId], references: [id], onDelete: Cascade)

  integranteId  String?
  integrante    Integrante? @relation(fields: [integranteId], references: [id], onDelete: SetNull)

  nomeVisitante String?
  presente      Boolean     @default(true)
}

model Banner {
  id                String   @id @default(cuid())
  tipo              String   // "ALERTA" | "EVENTO"
  titulo            String
  resumo            String
  descricaoCompleta String
  imagemUrl         String?
  dataExpiracao     DateTime
  ativo             Boolean  @default(true)

  criadoPorId       String
  criadoPor         Usuario  @relation("BannerCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm          DateTime @default(now())
}

model PausaEncontro {
  id           String    @id @default(cuid())
  dataInicio   DateTime  @default(now())
  dataFim      DateTime?
  motivo       String
  criadoPorId  String?
  criadoEm     DateTime  @default(now())
}

model CampanhaCamiseta {
  id                  String           @id @default(cuid())
  titulo              String
  descricao           String?
  fotos               String           // JSON array de URLs das fotos
  modelos             String           // JSON array de modelos (ex: ["Branca", "Preta"])
  tamanhosDisponiveis String           // JSON array de tamanhos (ex: ["PP", "P", "M", "G", "GG", "XGG"])
  precoUnitario       Float
  permiteNome         Boolean          @default(false)
  permiteNumero       Boolean          @default(false)
  dataFim             DateTime
  ativa               Boolean          @default(true)
  criadoEm            DateTime         @default(now())
  atualizadoEm        DateTime         @updatedAt

  pedidos             PedidoCamiseta[]
  campanhasInscricao  CampanhaInscricao[]
}

model PedidoCamiseta {
  id                 String           @id @default(cuid())
  campanhaId         String
  campanha           CampanhaCamiseta @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  codigoPedido       String           @unique
  nomeComprador      String
  telefoneComprador  String
  modelo             String
  tamanho            String
  quantidade         Int              @default(1)
  personalizacaoNome String?
  personalizacaoNum  String?
  formaPagamento     String           // "PIX" | "DINHEIRO"
  tipoQuitacao       String           // "INTEGRAL" | "PARCELADO_50_50"
  valorTotal         Float
  valorPago          Float            @default(0)
  statusPagamento    String           @default("PENDENTE") // "PENDENTE" | "PAGO_PARCIAL" | "PAGO_TOTAL"
  entregue           Boolean          @default(false)
  observacao         String?
  criadoEm           DateTime         @default(now())
  atualizadoEm       DateTime         @updatedAt
}

model ConfiguracaoGeral {
  id                         Int      @id @default(1)

  // Identidade Visual e Replicação do Grupo
  nomeGrupo                  String   @default("JUSC")
  subtituloGrupo             String   @default("Jovens Unidos Seguindo Cristo")
  paroquiaNome               String   @default("Paróquia Menino Jesus")
  logoUrl                    String?  @default("/assets/logo-jusc.jpeg")
  mascoteUrl                 String?
  corBase                    String   @default("#FFC72C")
  corSecundaria              String?  @default("#d97706")
  corDestaque                String?  @default("#f59e0b")
  descricaoGrupo             String?  @default("Venha participar dos nossos encontros! Um grupo jovem de oração, amizade verdadeira, música e missão.")

  // Liderança
  coordenadorNome            String   @default("Brunão")
  coordenadorFotoUrl         String?  @default("/assets/coordenador.jpg")
  coordenadorWhatsapp        String   @default("5545999068852")
  coordenadorMensagem        String   @default("Oii, vim pelo site e queria saber mais sobre o JUSCÃO")

  secretarioNome             String   @default("Foletto")
  secretarioFotoUrl          String?  @default("/assets/secretario.jpg")
  secretarioWhatsapp         String   @default("5545991179727")
  secretarioMensagem         String   @default("Oii, vim pelo site e queria marcar um encontro no JUSC")

  // Tesouraria e Checkout Pix (Confidencial)
  tesoureiroNome             String?  @default("Tesoureiro")
  tesoureiroWhatsapp         String?  @default("5545991179727")
  tesoureiroChavePix         String?  @default("")
  tesoureiroTipoChave        String?  @default("ALEATORIA")
  tesoureiroCidadePix        String?  @default("Foz do Iguacu")

  // Endereço, Horário e Redes
  enderecoPadrao             String   @default("Salinha do JUSC — Paróquia Menino Jesus (Av. Pôr do Sol, 2200, Conjunto Libra)")
  horarioPadrao              String   @default("Domingos às 17h")
  linkGoogleMaps             String   @default("https://maps.google.com/?q=Avenida+P%C3%B4r+do+Sol,+2200,+Conjunto+Libra,+Foz+do+Igua%C3%A7u+-+PR")
  instagramUrl               String?  @default("https://www.instagram.com/juscpmj?stkn=MWJhbGsyd2ZidHY1Mw==")

  // Pausa de Encontros / Recesso Pastoral
  encontrosPausados          Boolean  @default(false)
  pausadoEm                  DateTime?
  motivoPausa                String?

  // Regras de negócio configuráveis
  limiteMesesAlertaAusencia  Int      @default(2)
  limiteMesesInativacao      Int      @default(12)

  atualizadoEm               DateTime @updatedAt
}

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  acao      String
  detalhes  String?
  criadoEm  DateTime @default(now())
}

model CampanhaInscricao {
  id                         String            @id @default(cuid())
  titulo                     String
  descricao                  String?
  fotoUrl                    String?
  dataLimite                 DateTime
  dataLimitePagamento        DateTime?
  ativa                      Boolean           @default(true)

  // Financeiro
  requerPagamento            Boolean           @default(false)
  valor                      Float             @default(0)
  permiteParcelamento        Boolean           @default(false)

  // Campos modulares configuráveis pelo admin
  campoNomeCompleto          Boolean           @default(true)
  campoCpf                   Boolean           @default(false)
  campoTelefone              Boolean           @default(true)
  campoDataNascimento        Boolean           @default(true)
  campoNomeResponsavel       Boolean           @default(false)
  campoParentescoResponsavel Boolean           @default(false)
  campoTelefoneResponsavel   Boolean           @default(false)
  campoAlergia               Boolean           @default(false)
  campoIntolerancia          Boolean           @default(false)
  campoRemedioContinuo       Boolean           @default(false)
  campoSexo                  Boolean           @default(false)
  campoBatismo               Boolean           @default(false)
  campoPrimeiraEucaristia    Boolean           @default(false)
  campoCrisma                Boolean           @default(false)

  // Suporte a Grupo de WhatsApp do Evento
  linkGrupoWhatsapp          String?

  // Suporte a Camiseta no Evento
  permiteCamiseta            Boolean           @default(false)
  campanhaCamisetaId         String?
  campanhaCamiseta           CampanhaCamiseta? @relation(fields: [campanhaCamisetaId], references: [id], onDelete: SetNull)
  camisetaInclusaNoValor     Boolean           @default(false)

  criadoEm                   DateTime          @default(now())
  atualizadoEm               DateTime          @updatedAt

  inscricoes                 InscricaoEvento[]
}

model InscricaoEvento {
  id                    String            @id @default(cuid())
  campanhaId            String
  campanha              CampanhaInscricao @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  codigoInscricao       String            @unique

  // Dados do participante
  nomeCompleto          String
  cpf                   String?
  telefone              String
  dataNascimento        DateTime?
  sexo                  String?           // "MASCULINO" | "FEMININO"

  // Responsável (se menor ou solicitado)
  nomeResponsavel       String?
  parentescoResponsavel String?
  telefoneResponsavel   String?

  // Restrições de saúde e medicamentos
  possuiAlergia              Boolean           @default(false)
  descricaoAlergia           String?
  intoleranciaGluten         Boolean           @default(false)
  intoleranciaLactose        Boolean           @default(false)
  usaRemedioContinuo         Boolean           @default(false)
  descricaoRemedioContinuo   String?

  // Sacramentos
  batismo               Boolean           @default(false)
  primeiraEucaristia    Boolean           @default(false)
  crisma                Boolean           @default(false)

  // Suporte a Grupo de WhatsApp
  entrouNoGrupoWhatsapp Boolean           @default(false)
  clicouGrupoEm         DateTime?

  // Camiseta pedida no Evento
  pediuCamiseta               Boolean           @default(false)
  camisetaModelo              String?
  camisetaTamanho             String?
  camisetaNomePersonalizado   String?
  camisetaNumeroPersonalizado String?
  camisetaValor               Float             @default(0)

  // Financeiro
  formaPagamento        String?           // "PIX" | "DINHEIRO" | "ISENTO"
  tipoQuitacao          String?           // "INTEGRAL" | "PARCELADO_50_50"
  valorTotal            Float             @default(0)
  valorPago             Float             @default(0)
  statusPagamento       String            @default("ISENTO") // "PENDENTE" | "PAGO_PARCIAL" | "PAGO_TOTAL" | "ISENTO" | "CANCELADO"

  // Status geral
  status                String            @default("CONFIRMADA") // "CONFIRMADA" | "PENDENTE" | "CANCELADA"
  observacao            String?

  criadoEm              DateTime          @default(now())
  atualizadoEm          DateTime          @updatedAt
}

