// Prisma Schema para JUSC Web (produção com PostgreSQL / Docker)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id             String         @id @default(cuid())
  nome           String
  login          String         @unique // Nome de usuário definido pelo admin (ex: admin, brunao, foletto)
  email          String?        // E-mail opcional
  senhaHash      String
  perfil         String         @default("COLABORADOR") // "ADMIN" | "COLABORADOR"
  status         String         @default("ATIVO")       // "ATIVO" | "INATIVO"
  primeiroAcesso Boolean        @default(true)          // Se true, exige troca no primeiro acesso
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  integrantesCadastrados Integrante[]   @relation("CadastradoPor")
  encontrosCriados       Encontro[]     @relation("EncontroCriadoPor")
  bannersCriados         Banner[]       @relation("BannerCriadoPor")
  auditorias             LogAuditoria[]
}

model Integrante {
  id                     String    @id @default(cuid())
  nomeCompleto           String
  apelido                String?
  telefone               String
  dataNascimento         DateTime
  nomeResponsavel        String
  telefoneResponsavel    String
  fotoUrl                String?

  // Lógica de tempo de grupo com 3 níveis de precisão
  tempoGrupoPrecisao     String    @default("DESCONHECIDA") // "COMPLETA" | "MES_ANO" | "DESCONHECIDA"
  tempoGrupoDataCompleta DateTime?
  tempoGrupoMes          Int?
  tempoGrupoAno          Int?

  // Sacramentos
  batismo                Boolean   @default(false)
  primeiraEucaristia     Boolean   @default(false)
  crisma                 Boolean   @default(false)

  // Grupo WhatsApp
  noGrupoWhatsapp        Boolean   @default(false)

  // Saúde e Restrições Alimentares (Alergias e Intolerâncias)
  possuiAlergia          Boolean   @default(false)
  descricaoAlergia       String?
  intoleranciaGluten     Boolean   @default(false)
  intoleranciaLactose    Boolean   @default(false)

  observacao             String?
  status                 String    @default("ATIVO") // "ATIVO" | "INATIVO"
  motivoInativacao       String?

  cadastradoPorId        String
  cadastradoPor          Usuario   @relation("CadastradoPor", fields: [cadastradoPorId], references: [id])
  dataCadastro           DateTime  @default(now())
  atualizadoEm           DateTime  @updatedAt

  presencas              Presenca[]
}

model Encontro {
  id           String     @id @default(cuid())
  dataHora     DateTime
  local        String
  conduzidoPor String
  tema         String?

  criadoPorId  String
  criadoPor    Usuario    @relation("EncontroCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm     DateTime   @default(now())

  presencas    Presenca[]
}

model Presenca {
  id            String      @id @default(cuid())
  encontroId    String
  encontro      Encontro    @relation(fields: [encontroId], references: [id], onDelete: Cascade)

  integranteId  String?
  integrante    Integrante? @relation(fields: [integranteId], references: [id], onDelete: SetNull)

  nomeVisitante String?
  presente      Boolean     @default(true)
}

model Banner {
  id                String   @id @default(cuid())
  tipo              String   // "ALERTA" | "EVENTO"
  titulo            String
  resumo            String
  descricaoCompleta String
  imagemUrl         String?
  dataExpiracao     DateTime
  ativo             Boolean  @default(true)

  criadoPorId       String
  criadoPor         Usuario  @relation("BannerCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm          DateTime @default(now())
}

model ConfiguracaoGeral {
  id                         Int      @id @default(1)
  coordenadorNome            String   @default("Brunão")
  coordenadorFotoUrl         String?  @default("/assets/coordenador.jpg")
  coordenadorWhatsapp        String   @default("5545999068852")
  coordenadorMensagem        String   @default("Oii, vim pelo site e queria saber mais sobre o JUSCÃO")

  secretarioNome             String   @default("Foletto")
  secretarioFotoUrl          String?  @default("/assets/secretario.jpg")
  secretarioWhatsapp         String   @default("5545991179727")
  secretarioMensagem         String   @default("Oii, vim pelo site e queria marcar um encontro no JUSC")

  enderecoPadrao             String   @default("Salinha do JUSC — Paróquia Menino Jesus (Av. Pôr do Sol, 2200, Conjunto Libra)")
  horarioPadrao              String   @default("Domingos às 17h")
  linkGoogleMaps             String   @default("https://maps.google.com/?q=Avenida+P%C3%B4r+do+Sol,+2200,+Conjunto+Libra,+Foz+do+Igua%C3%A7u+-+PR")
  instagramUrl               String?  @default("https://www.instagram.com/juscpmj?stkn=MWJhbGsyd2ZidHY1Mw==")

  // Regras de negócio configuráveis
  limiteMesesAlertaAusencia  Int      @default(3)
  limiteMesesInativacao      Int      @default(12)

  atualizadoEm               DateTime @updatedAt
}

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  acao      String
  detalhes  String?
  criadoEm  DateTime @default(now())
}
